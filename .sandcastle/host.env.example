# The watcher's own file. Read on the host by .sandcastle/src/env.mts and never
# forwarded anywhere — which is the whole point: .sandcastle/.env, its sibling, is
# handed to the sandbox container key by key, so nothing here may live there.
#
# Per checkout rather than in a shell profile, so that a second golem on this
# machine is a second clone with its own project, its own channel and its own
# board — and so that `export` in one terminal is still how you override a single
# run, because the shell wins over this file.
#
# Copy to `host.env` and fill in — the real file is gitignored.
# See docs/adr/0009-two-env-files-one-for-each-side.md.

# --------------------------------------------------------------- the tracker

# Which adapter reads the queue — `github` (the default) or `jira`.
SANDCASTLE_TRACKER=

# Jira Cloud, when SANDCASTLE_TRACKER=jira. The token is a personal API token
# from id.atlassian.com → Security → API tokens, used with the email as basic
# auth against the REST v3 API. JIRA_PROJECT is the project *key* — the prefix
# your issue keys carry, e.g. ESCB in ESCB-123.
JIRA_BASE_URL=
JIRA_PROJECT=
JIRA_EMAIL=
JIRA_API_TOKEN=

# ------------------------------------------------------------------- notices

# Slack bot token for the watcher's notifications (src/slack.mts). The app needs
# the `chat:write` bot scope and must be invited to the channel. SLACK_MENTION is
# optional — a member id (⋮ → Copy member ID), a user group id, or here/channel.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
SLACK_MENTION=

# Watchtower — the dashboard sink beside Slack (src/watchtower.mts). Both lines
# are minted together by Watchtower's settings page when the Project is created;
# the key is shown there once and stored only as a hash. Unset means the emitter
# is off and the watcher behaves exactly as it did before.
WATCHTOWER_URL=
WATCHTOWER_API_KEY=

# ------------------------------------------------------------------- the run

# Optional overrides for config.mts's defaults. Left commented out, at their
# defaults, because a golem that needs none of them should say so by silence.
# SANDCASTLE_BASE=origin/main
# SANDCASTLE_MODEL=opus
# SANDCASTLE_REVIEW_MODEL=sonnet
# SANDCASTLE_POLL_SECONDS=120
