{
  "name": "fs-fe-boilerplate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "panda codegen",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "exec eslint .",
    "e2e": "playwright test --project=chromium",
    "e2e:ui": "playwright test --ui --project=chromium",
    "e2e:debug": "playwright test --debug --project=chromium",
    "e2e:report": "playwright show-report",
    "e2e:headed": "playwright test --headed --project=chromium",
    "e2e:standalone": "pnpm build:e2e && E2E_STANDALONE=true pnpm e2e",
    "golem": "golem",
    "golem:build-image": "golem build-image",
    "golem:jira-smoke": "GOLEM_TRACKER=jira golem jira-smoke",
    "golem:smoke": "golem smoke"
  },
  "dependencies": {
    "@finstreet/forms": "0.0.200",
    "@finstreet/secure-fetch": "^0.0.88",
    "@finstreet/ui": "0.1.48",
    "@tanstack/react-query": "^5.67.0",
    "dayjs": "1.11.18",
    "iban": "0.0.14",
    "libphonenumber-js": "^1.12.9",
    "next": "16.1.6",
    "next-auth": "beta",
    "next-intl": "4.8.3",
    "nuqs": "2.4.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.53.2",
    "react-icons": "^5.5.0",
    "zod": "4.0.17",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^9.2.0",
    "@finstreet/golem-engine": "0.2.0",
    "@next/eslint-plugin-next": "16.1.6",
    "@pandacss/dev": "0.45.2",
    "@playwright/test": "^1.58.2",
    "@types/eslint": "9.6.1",
    "@types/iban": "^0.0.35",
    "@types/node": "^20",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@typescript-eslint/eslint-plugin": "8.58.1",
    "@typescript-eslint/parser": "8.58.1",
    "dotenv": "^17.1.0",
    "eslint": "10.2.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-only-warn": "^1.1.0",
    "globals": "^16.4.0",
    "mailtrap": "4.3.0",
    "prettier": "3.3.3",
    "typescript": "^5.6.3"
