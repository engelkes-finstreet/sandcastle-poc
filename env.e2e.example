# Test accounts on staging — copy to .env.e2e and fill in.
#
# Two consumers, and they are independent:
#   - `pnpm test:e2e` reads these through e2e/utils/test-helpers.ts
#   - the golem's walkthrough phase carries this file into its container so the agent
#     can log in and photograph pages behind the auth wall
#
# .env.e2e is gitignored and must stay that way. .sandcastle/app-guide.md is the
# committed half: it names which role each variable below belongs to and where that
# role lands after login. Add a variable here and it belongs in that table too.
#
# Staging only, and treat every account as shared and throwaway. A production
# credential in this file puts production into every walkthrough container that runs.
# Rotate anything that leaks rather than hoping.
#
# An account missing here is not an error. The walkthrough reports which roles it
# could not photograph and why, which is a better outcome than a guessed password —
# repeated failures lock the account for everybody.

# PropertyManagement::PropertyManager — the customer portal, lands on /kunde/factoring-antraege
E2E_TEST_PROPERTY_MANAGER_EMAIL=
E2E_TEST_PROPERTY_MANAGER_PASSWORD=

# FinancialServiceProvider::Processor — operations, lands on /operations/factoring-antraege
E2E_TEST_FSP_EMAIL=
E2E_TEST_FSP_PASSWORD=

# FinancialServiceProvider::Admin — administration, lands on /admin/benutzer
E2E_TEST_FSP_ADMIN_EMAIL=
E2E_TEST_FSP_ADMIN_PASSWORD=

# FinancialServiceProvider::MasterDataManager — operations, same portal as Processor.
# The second account exists so the e2e suite can test two users of one role against each
# other; the walkthrough only ever needs the first.
E2E_TEST_FSP_MASTER_DATA1_EMAIL=
E2E_TEST_FSP_MASTER_DATA1_PASSWORD=
E2E_TEST_FSP_MASTER_DATA2_EMAIL=
E2E_TEST_FSP_MASTER_DATA2_PASSWORD=
